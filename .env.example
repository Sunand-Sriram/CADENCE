# Ollama endpoint for local model serving
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Redis broker/backend URL
# CRS_REDIS_URL=redis://127.0.0.1:6379/0
# Repository root containing the target project
# CRS_REPO_ROOT=./targets/target
# Relative path to the fuzz harness binary
# CRS_HARNESS_BIN_REL=fuzz_harness
# Model used by the Martian agent
# CRS_MARTIAN_MODEL=
# Model used by the Vincent agent
# CRS_VINCENT_MODEL=
# Build command for the target
# CRS_BUILD_CMD=true
# Test command for the target
# CRS_TEST_CMD=echo ok
# Directory for generated solutions/crashes
# CRS_SOLUTIONS_DIR=./crashes
# Directory for evidence artifacts
# CRS_EVIDENCE_DIR=./evidence
# LLM execution mode
# CRS_LLM_MODE=mock
# Directory containing mock responses
# CRS_MOCK_DIR=./mocks
